    // 2. IF ELSE STATEMENT

    $likesMovies = true;

    echo "<div class='example'>";

    echo "<h2>2. If...Else Statement</h2>";

    if ($likesMovies) {
        echo "<p>I like watching movies, especially when I have free time.</p>";
    } else {
        echo "<p>I don't really watch movies.</p>";
    }

    echo "</div>";


    // 3. IF ELSEIF ELSE STATEMENT

    $studyHours = 4;

    echo "<div class='example'>";

    echo "<h2>3. If...Elseif...Else Statement</h2>";

    echo "<p>Today, I studied for $studyHours hours.</p>";

    if ($studyHours >= 5) {

        echo "<p>I studied a lot today.</p>";

    } elseif ($studyHours >= 3) {

        echo "<p>I studied for a few hours today.</p>";

    } elseif ($studyHours >= 1) {

        echo "<p>I only studied for a little while today.</p>";

    } else {

        echo "<p>I didn't study today.</p>";

    }

    echo "</div>";


    // 4. SWITCH STATEMENT

    $favoriteActivity = "Movies";

    echo "<div class='example'>";

    echo "<h2>4. Switch Statement</h2>";

    switch ($favoriteActivity) {

        case "Movies":
            echo "<p>When I have free time, I usually binge-watch random movies.</p>";
            break;

        case "Gaming":
            echo "<p>I usually spend my free time playing games.</p>";
            break;

        case "Music":
            echo "<p>I usually spend my free time listening to music.</p>";
            break;

        case "Travel":
            echo "<p>I like spending my free time going to different places.</p>";
            break;

        default:
            echo "<p>I have different ways of spending my free time.</p>";
    }

    echo "</div>";

